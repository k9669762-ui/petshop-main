rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email == 'admin@gmail.com';
    }

    function isOwner() {
      return isAdminEmail();
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
